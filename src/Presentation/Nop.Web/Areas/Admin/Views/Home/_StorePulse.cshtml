@{
    const string cardId = "store-pulse-card";
    const string hideCardAttributeName = "Reports.HideStorePulseCard";
    var hideCard = await genericAttributeService.GetAttributeAsync<bool>(await workContext.GetCurrentCustomerAsync(), hideCardAttributeName);
}

<style>
    .store-pulse-tile .ico-help {
        color: #3c8dbc;
        margin-inline-start: 6px;
        cursor: help;
    }

    .store-pulse-count {
        margin-inline-start: 6px;
        font-weight: 600;
    }

    .store-pulse-tile .card-body {
        padding-top: 0;
    }

    .store-pulse-view-all-hint {
        margin: 8px 0 0;
    }
</style>
<div class="card card-primary card-outline @if(hideCard){<text>collapsed-card</text>}" id="@cardId">
    <div class="card-header with-border">
        <h3 class="card-title">
            <i class="fas fa-heartbeat"></i>
            @T("Admin.Dashboard.StorePulse")
        </h3>
        <div class="card-tools float-right">
            <button class="btn btn-tool" data-card-widget="collapse" type="button">
                @if (hideCard)
                {
                    <text><i class="fas fa-plus"></i></text>
                }
                else
                {
                    <text><i class="fas fa-minus"></i></text>
                }
            </button>
        </div>
    </div>
    <script>
        $(function() {
            var collapsed = !$('#@cardId').hasClass('collapsed-card');
            if (collapsed) {
                loadStorePulse();
            }

            $('#@cardId').on('click', 'button[data-card-widget="collapse"]', function () {
                collapsed = !$('#@cardId').hasClass('collapsed-card');
                saveUserPreferences('@(Url.Action("SavePreference", "Preferences"))', '@hideCardAttributeName', collapsed);
                if (!collapsed){
                    loadStorePulse();
                }
            });

            function loadStorePulse() {
                $('#storePulse').load('@Url.Action("GetStorePulse", "Home")', function (response, status) {
                    if (status === 'error')
                        $('#loadStorePulseAlert').trigger('click');
                });
            }
        });
    </script>
    <div class="card-body">
        <div id="storePulse"></div>
    </div>
</div>
